{
  "_comment": "ComfyUI API-format workflow: SDXL text-to-image. Placeholders {{...}} are filled by forge/engines/comfy.py. Checkpoint file must be in models/checkpoints (see models/models.json).",
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "{{checkpoint}}"}
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {"width": "{{width:int}}", "height": "{{height:int}}", "batch_size": "{{batch:int}}"}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{prompt}}", "clip": ["4", 1]}
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{negative}}", "clip": ["4", 1]}
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed:int}}",
      "steps": "{{steps:int}}",
      "cfg": "{{cfg:float}}",
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["3", 0], "vae": ["4", 2]}
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "forge", "images": ["8", 0]}
  }
}
