# environments
venv/
/engines/
__pycache__/
*.pyc
.pytest_cache/

# weights and outputs stay local (big; and outputs belong to the game repo once approved)
models/*
!models/models.json
!models/.gitkeep
out/*
!out/.gitkeep
logs/*
!logs/.gitkeep

# queue state is local to a machine; templates and game batches are tracked
jobs/pending/*
jobs/running/*
jobs/done/*
jobs/failed/*
!jobs/*/.gitkeep

# the commit-message inbox (push.bat): written per change, consumed by the push
COMMIT_MESSAGE.txt
COMMIT_MESSAGE.last.txt

# William's own model collections and photographs: local only, never pushed (2026-11-09).
# push.bat runs `git add -A`; without these lines a push would try to upload ~100 GB of weights and his photos.
sdmodels/
lora models/
flux_models/
flux_lora/
flux_workflow/
Bills Actual Art/
# the licence record a person checked IS tracked (approve depends on it)
!models/licences.json
jobs/paused/*

# hand-over folder for files written by an assistant session
_incoming/
out/_ui_thumbs/

# installers and licensed third-party files: never pushed (2026-11-10, Night 3B).
# The Filter Forge installers were sitting in the repo root; push.bat runs `git add -A`. Filters (.ffxml) may not be
# redistributed (Filter Forge EULA) - the forge stores paths to them, never copies.
/*.exe
*.ffxml
