# environments
venv/
/engines/
__pycache__/
*.pyc
.pytest_cache/

# weights and outputs stay local (big; and outputs belong to the game repo once approved)
models/*
!models/models.json
!models/.gitkeep
out/*
!out/.gitkeep
logs/*
!logs/.gitkeep

# queue state is local to a machine; templates and game batches are tracked
jobs/pending/*
jobs/running/*
jobs/done/*
jobs/failed/*
!jobs/*/.gitkeep

# the commit-message inbox (push.bat): written per change, consumed by the push
COMMIT_MESSAGE.txt
COMMIT_MESSAGE.last.txt

# William's own model collections and photographs: local only, never pushed (2026-11-09).
# push.bat runs `git add -A`; without these lines a push would try to upload ~100 GB of weights and his photos.
sdmodels/
lora models/
flux_models/
flux_lora/
flux_workflow/
Bills Actual Art/
# the licence record a person checked IS tracked (approve depends on it)
!models/licences.json
jobs/paused/*

# hand-over folder for files written by an assistant session
_incoming/
out/_ui_thumbs/

# installers and licensed third-party files: never pushed (2026-11-10, Night 3B).
# The Filter Forge installers were sitting in the repo root; push.bat runs `git add -A`. Filters (.ffxml) may not be
# redistributed (Filter Forge EULA) - the forge stores paths to them, never copies.
/*.exe
*.ffxml

# Night 4 (F6): which of William's photographs may be used (paths + people check) - local only, never pushed
games/*/refs.local.json
# Night 4: run-state, not source
jobs/_cancelled*/
jobs/drafts/
jobs/_held*/

# Night 4: notes and data that are William's own or one game's — on this PC only, never pushed
/local/

# RPG_Forge is game-agnostic (William, 2026-11-10): no game's own data is ever pushed.
games/*
!games/README.md
!games/_example/
# session notes, plans and hand-offs are per game → local/<game>/ (ignored above via /local/)
/CHANGELOG.md
/_old_sprite_bakeoff.bat.txt
# one game's run scripts (they name that game's suites) — kept beside the forge on this PC, not pushed
/SPRITE_[0-9]_*.bat
/bakeoff_tonight*.bat
/bakeoff_finish.bat
/bakeoff_flux.bat
/bakeoff_new_models.bat
/bakeoff_styles.bat
/test_tools.bat
# BUILD 01: the suite's run-state inside the example game (journal, proposals, backups, temp) — and its per-install settings live in /local/ (ignored above)
games/_example/game/journal/
games/_example/game/proposals/
games/_example/game/_workbench_backups/
games/_example/game/_workbench_tmp/
games/_example/game/WORKBENCH_LOG.md
# BUILD 03: the example game's mail run-state — the three example letters are tracked, everything else it grows is not
games/_example/game/mail/state.json
games/_example/game/mail/*/*
!games/_example/game/mail/to_bill/20261110-091500_claude-fable_ember-crossing-s-greeting-and-the-harbor.md
!games/_example/game/mail/to_bill/20261110-094000_claude-opus_the-example-game-s-first-build-three-pla.md
!games/_example/game/mail/to_claude/20261110-100500_bill_the-miller-s-second-line.md
games/_example/game/work_orders/
# BUILD 04: what the example game's sprite intake and registry grow (dropped sheets, mappings, cut-outs, history)
games/_example/intake/
games/_example/characters/_history/
games/_example/batches/
